---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

const registerUrl = 'https://platform.kioskit.space/register';
const whatsappUrl = 'https://wa.me/595982373124?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20Kioskit';
const siteUrl = 'https://kioskit.space/';
const pageTitle = 'Kioskit | Sistema de gestión para emprendedores';
const pageDescription = 'Gestioná ventas, compras, stock y dinero con Kioskit. Adaptá el sistema a tu negocio y apoyate en Kiosquito para resolver tareas con IA.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Kioskit',
      url: siteUrl,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Kioskit',
      url: siteUrl,
      inLanguage: 'es-PY',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}#app`,
      name: 'Kioskit',
      url: siteUrl,
      description: pageDescription,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'es-PY',
      publisher: { '@id': `${siteUrl}#organization` },
      offers: {
        '@type': 'Offer',
        price: '150000',
        priceCurrency: 'PYG',
        description: 'Suscripción mensual',
        url: `${siteUrl}#empezar`,
      },
    },
  ],
};

const modules = [
  { title: 'Ventas', description: 'Registrá y cobrá.', icon: 'ventas' },
  { title: 'Compras', description: 'Mercadería, pagos y deudas.', icon: 'compras' },
  { title: 'Inventario', description: 'Stock y movimientos.', icon: 'inventario' },
  { title: 'Dinero', description: 'Ingresos, gastos y saldos.', icon: 'dinero' },
  { title: 'Clientes y proveedores', description: 'Tus contactos y operaciones, en orden.', icon: 'personas' },
  { title: 'Tienda online', description: 'Publicá tu catálogo y recibí pedidos.', icon: 'tienda' },
];

const problemSteps = [
  { desktop: '/design/venta-pensando-desktop.webp', mobile: '/design/venta-pensando-mobile.webp', label: 'Kiosquito ayuda a preparar una nueva venta' },
  { desktop: '/design/venta-registrando-desktop.webp', mobile: '/design/venta-registrando-mobile.webp', label: 'Kiosquito registra los datos de la venta' },
  { desktop: '/design/venta-confirmada-desktop.webp', mobile: '/design/venta-confirmada-mobile.webp', label: 'La venta queda registrada y confirmada' },
];
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F7FB" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kioskit" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://kioskit.space/og-kiosquito.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1734" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content="Kiosquito saluda junto al nombre Kioskit y la frase Un sistema que sigue el ritmo de tu negocio" />
    <meta property="og:url" content="https://kioskit.space/" />
    <meta property="og:locale" content="es_PY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://kioskit.space/og-kiosquito.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader active="home" />
    <main id="contenido">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">Sistema de gestión para emprendedores</p>
            <h1 id="hero-title">Emprender ya es bastante. Kioskit te da una mano.</h1>
            <p class="hero-description">La herramienta para llevar tu emprendimiento que podés adaptar a tu forma de trabajar, mientras entendés qué está pasando y decidís qué hacer después.</p>
            <div class="button-row">
              <a class="button button-primary" href={registerUrl}>Empezar con Kioskit</a>
              <a class="button button-secondary" href="#problema">Ver cómo funciona</a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <span class="hero-halo"></span>
            <span class="hero-spark"></span>
            <picture>
              <source media="(max-width: 767px)" srcset="/design/hero-mobile.webp" />
              <img src="/design/hero-desktop.webp" alt="" width="846" height="856" fetchpriority="high" />
            </picture>
          </div>
        </div>
      </section>

      <section class="problem" id="problema" aria-labelledby="problem-title">
        <div class="container problem-layout">
          <div class="problem-visual" role="img" aria-label="Tres momentos de una venta en Kioskit: preparar, registrar y confirmar">
            {problemSteps.map((step, index) => (
              <picture class={`problem-step problem-step-${index + 1}`} aria-hidden="true">
                <source media="(max-width: 767px)" srcset={step.mobile} />
                <img src={step.desktop} alt={step.label} width="700" height="512" loading="lazy" />
              </picture>
            ))}
          </div>
          <div class="problem-copy">
            <h2 id="problem-title">Tu negocio cambia. Llevarle el ritmo cuesta.</h2>
            <p>Ventas, gastos y pendientes quedan en tu cabeza o repartidos en distintos lugares. Y si ya usás un sistema, lo que es propio de tu negocio muchas veces queda afuera. Al final, entender qué pasó se vuelve otro trabajo.</p>
          </div>
        </div>
      </section>

      <section class="modules section" id="funciones" aria-labelledby="modules-title">
        <div class="container">
          <h2 id="modules-title">Para vender, comprar y saber cómo va tu negocio</h2>
          <div class="modules-grid">
            <div class="modules-small-grid">
              {modules.map((item) => (
                <article class="module-card">
                  <svg class="module-icon" aria-hidden="true"><use href={`#icon-${item.icon}`} /></svg>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
            <article class="invoice-card">
              <span class="invoice-icon" aria-hidden="true">▣</span>
              <h3>Facturación electrónica</h3>
              <p class="invoice-message">La factura no debería ser otra tarea.</p>
              <p class="invoice-description">Vendé y facturá sin salir de Kioskit.</p>
              <span class="invoice-status"><span aria-hidden="true">✓</span> Factura emitida</span>
              <img src="/design/kiosquito-facturacion.webp" alt="" width="130" height="130" loading="lazy" />
            </article>
          </div>
          <div class="section-transition" aria-hidden="true"><span></span><span></span></div>
        </div>
      </section>

      <section class="catalog-feature section" id="catalogo" aria-labelledby="catalog-title">
        <div class="container catalog-layout">
          <div class="catalog-copy">
            <p class="catalog-label">También tenés tienda online</p>
            <h2 id="catalog-title">Tu catálogo, listo para compartir.</h2>
            <p>Publicá tus productos con precios y stock al día. Compartí el enlace por WhatsApp o redes; tus clientes arman el pedido y te llega a Kioskit.</p>
          </div>
          <div class="catalog-visual" aria-hidden="true">
            <div class="catalog-window">
              <div class="catalog-window-header">
                <span class="catalog-store-icon"><svg><use href="#icon-tienda" /></svg></span>
                <span><strong>Tu tienda</strong><small>Productos para elegir</small></span>
                <span class="catalog-window-dots">•••</span>
              </div>
              <div class="catalog-window-search">Buscar productos <span>⌕</span></div>
              <div class="catalog-products">
                <div class="catalog-product">
                  <span class="catalog-product-art catalog-product-coffee"><span></span></span>
                  <strong>Café molido</strong>
                  <small>Disponible</small>
                </div>
                <div class="catalog-product">
                  <span class="catalog-product-art catalog-product-yerba"><span></span></span>
                  <strong>Yerba mate</strong>
                  <small>Disponible</small>
                </div>
              </div>
            </div>
            <span class="catalog-link"><span>↗</span> Compartí tu tienda</span>
            <span class="catalog-order"><span>✓</span> Nuevo pedido</span>
          </div>
        </div>
      </section>

      <section class="adapt section" id="adaptabilidad" aria-labelledby="adapt-title">
        <div class="container adapt-inner">
          <h2 id="adapt-title">Tu negocio tiene su forma de trabajar. Armala en Kioskit.</h2>
          <p>¿Tomás encargos o hacés reparaciones? Definí qué datos guardar, qué etapas seguir y cómo querés ver cada trabajo. Kiosquito te ayuda a armarlo.</p>
          <picture class="adapt-demo">
            <source media="(max-width: 767px)" srcset="/design/adaptabilidad-mobile.webp" />
            <img src="/design/adaptabilidad-desktop.webp" alt="Una indicación a Kiosquito se convierte en un espacio de Reparaciones con campos, etapas y trabajos" width="1312" height="520" loading="lazy" />
          </picture>
        </div>
      </section>

      <section class="copilot section" id="kiosquito" aria-labelledby="copilot-title">
        <div class="container copilot-layout">
          <div class="copilot-copy">
            <h2 id="copilot-title">Kiosquito te ayuda con el trabajo de todos los días</h2>
            <p>Pasale los datos de un producto, pedile que cargue una venta o que complete un formulario. Si tenés una duda, preguntale cómo hacer algo en Kioskit o qué está pasando en tu negocio.</p>
            <ul class="use-cases" aria-label="Otras formas de usar Kiosquito">
              <li>Cargar ventas</li>
              <li>Completar formularios</li>
              <li>Resolver dudas</li>
            </ul>
          </div>
          <picture class="copilot-demo">
            <source media="(max-width: 767px)" srcset="/design/kiosquito-productos-mobile.webp" />
            <img src="/design/kiosquito-productos-desktop.webp" alt="Kiosquito prepara dos fichas de producto para que la persona revise y confirme" width="708" height="614" loading="lazy" />
          </picture>
        </div>
      </section>

      <section class="automations section" id="automatizaciones" aria-labelledby="automations-title">
        <div class="container automations-inner">
          <h2 id="automations-title">Si pasa esto, Kioskit hace aquello.</h2>
          <p>Elegí qué lo activa y qué querés que pase: recibir un aviso, actualizar información o enviar un correo.</p>
          <picture class="automations-demo">
            <source media="(max-width: 767px)" srcset="/design/automatizaciones-mobile.webp" />
            <img src="/design/automatizaciones-desktop.webp" alt="Automatización: cuando se registra una venta de Café molido, Kioskit envía un correo al proveedor" width="1264" height="380" loading="lazy" />
          </picture>
        </div>
      </section>

      <section class="external-ai section" id="conexiones" aria-labelledby="external-ai-title">
        <div class="container external-ai-layout">
          <div class="external-ai-copy">
            <h2 id="external-ai-title">Kioskit también trabaja con la IA que ya usás.</h2>
            <p>Conectalo con ChatGPT o Claude para consultar tu negocio y pedirle que haga tareas desde ahí.</p>
          </div>
          <picture class="external-ai-demo">
            <source media="(max-width: 767px)" srcset="/design/ia-externa-mobile.webp" />
            <img src="/design/ia-externa-desktop.webp" alt="ChatGPT y Claude conectados con Kioskit para consultar las ventas del negocio" width="598" height="382" loading="lazy" />
          </picture>
        </div>
      </section>

      <section class="answers section" id="preguntas" aria-labelledby="answers-title">
        <div class="container answers-layout">
          <div class="answers-intro">
            <p class="answers-label">Kioskit en pocas palabras</p>
            <h2 id="answers-title">Lo esencial, sin vueltas.</h2>
            <p>Un sistema de gestión para emprendedores que reúne el trabajo diario y se adapta a la forma de trabajar de cada negocio.</p>
          </div>
          <div class="answers-list">
            <article>
              <h3>¿Qué es Kioskit y qué puedo hacer con él?</h3>
              <p>Kioskit es un sistema de gestión para emprendedores. Permite registrar ventas y compras, controlar el stock, llevar ingresos y gastos, gestionar contactos y vender en una tienda online.</p>
            </article>
            <article>
              <h3>¿Sirve si mi negocio tiene procesos propios?</h3>
              <p>Sí. Podés crear espacios para trabajos como encargos o reparaciones, definir sus datos y etapas, y automatizar tareas.</p>
            </article>
            <article>
              <h3>¿Necesito usar ChatGPT o Claude?</h3>
              <p>No. Kiosquito te ayuda dentro de Kioskit. Conectar ChatGPT o Claude es una opción si preferís trabajar desde esas herramientas.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="closing section" id="empezar" aria-labelledby="closing-title">
        <div class="container closing-inner">
          <h2 id="closing-title">Dale a tu negocio un sistema que pueda seguirle el ritmo.</h2>
          <p class="closing-description">Empezá con lo que necesitás hoy. Kioskit te acompaña cuando tu forma de trabajar cambia.</p>
          <div class="plan">
            <span class="plan-label">Un solo plan</span>
            <p class="price">G. 150.000 <span>/ mes</span></p>
            <p class="plan-includes">Ventas, compras, stock, facturación electrónica, procesos propios, automatizaciones y Kiosquito incluidos.</p>
          </div>
          <div class="button-row closing-actions">
            <a class="button button-primary" href={registerUrl}>Empezar con Kioskit</a>
            <a class="button button-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp</a>
          </div>
          <picture class="closing-mascot" aria-hidden="true">
            <source media="(max-width: 767px)" srcset="/design/kiosquito-cierre-mobile.webp" />
            <img src="/design/kiosquito-cierre-desktop.webp" alt="" width="176" height="176" loading="lazy" />
          </picture>
          <footer class="footer">
            <div><a class="footer-brand" href="#contenido">Kioskit</a><small>© 2026 Kioskit</small></div>
            <nav aria-label="Enlaces del sitio">
              <a href="https://platform.kioskit.space/login">Iniciar sesión</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Contacto</a>
              <a href="#funciones">Funciones</a>
            </nav>
          </footer>
        </div>
      </section>
    </main>

    <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="icon-ventas" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/></symbol>
      <symbol id="icon-compras" viewBox="0 0 24 24"><path d="M4 8h16l-1.5 12h-13L4 8ZM8 8V6a4 4 0 0 1 8 0v2M9 12v4M15 12v4"/></symbol>
      <symbol id="icon-inventario" viewBox="0 0 24 24"><path d="m3 7 9-4 9 4-9 4-9-4ZM3 7v10l9 4 9-4V7M12 11v10"/></symbol>
      <symbol id="icon-dinero" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M16 14h2"/></symbol>
      <symbol id="icon-personas" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5v1"/></symbol>
      <symbol id="icon-tienda" viewBox="0 0 24 24"><path d="M3 9h18l-2-5H5L3 9ZM5 9v11h14V9M9 20v-7h6v7"/></symbol>
    </svg>
  </body>
</html>
