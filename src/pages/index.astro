---
import "../styles/global.css";

const APP_URL = "https://app.kioskit.space";
const REGISTER_URL = `${APP_URL}/register`;
const LOGIN_URL = `${APP_URL}/login`;
const WA_NUMBER = "595982373124";
const WA_URL = `https://wa.me/${WA_NUMBER}?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20KiosKit`;

const faqs = [
  {
    q: "¿Necesito instalar algo?",
    a: "No. KiosKit funciona desde el navegador en computadora, tablet o celular. Creás tu cuenta y podés empezar a ordenar tu operación.",
  },
  {
    q: "¿Puedo probarlo antes de pagar?",
    a: "Sí. Tenés 15 días para probar la experiencia completa de KiosKit, sin tarjeta. Después, hay un único plan de Gs. 150.000 al mes por negocio.",
  },
  {
    q: "¿KiosKit sirve solamente para tiendas?",
    a: "Hoy está especialmente preparado para comercios y retail. La plataforma seguirá creciendo para acompañar también a servicios, gastronomía y otras formas de emprender.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="KiosKit reúne ventas, inventario y la operación diaria de tu negocio en una herramienta simple, rápida y hecha para crecer con vos."
    />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href="https://kioskit.space/" />
    <meta property="og:title" content="KiosKit — Tu negocio, bajo control" />
    <meta
      property="og:description"
      content="Capacidades grandes, sin la complejidad de una empresa grande."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kioskit.space/" />
    <meta property="og:locale" content="es_PY" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>KiosKit — Tu negocio, bajo control</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-header>
      <div class="shell header-inner">
        <a href="#inicio" class="brand" aria-label="KiosKit, inicio">
          <span class="brand-mark" aria-hidden="true">K</span>
          <span>KiosKit</span>
        </a>

        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#producto">Producto</a>
          <a href="#inteligencia">Inteligencia</a>
          <a href="#catalogo">Catálogo</a>
          <a href="#precio">Precio</a>
        </nav>

        <div class="header-actions">
          <a class="login-link" href={LOGIN_URL}>Iniciar sesión</a>
          <a class="button button-small" href={REGISTER_URL}>Crear cuenta</a>
          <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button>
            <span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="mobile-nav" aria-label="Navegación móvil" data-mobile-menu>
        <a href="#producto">Producto</a>
        <a href="#inteligencia">Inteligencia</a>
        <a href="#catalogo">Catálogo</a>
        <a href="#precio">Precio</a>
        <a href={LOGIN_URL}>Iniciar sesión</a>
        <a class="button" href={REGISTER_URL}>Crear cuenta</a>
      </nav>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="shell hero-copy" data-reveal>
          <p class="eyebrow"><span></span> Hecho para negocios que no paran</p>
          <h1>Capacidades grandes.<br /><em>Sin la complejidad</em><br />de una empresa grande.</h1>
          <p class="hero-lead">
            KiosKit reúne ventas, inventario y el día a día de tu negocio en una herramienta
            simple, con un copiloto que entiende lo que necesitás hacer.
          </p>
          <div class="hero-actions">
            <a class="button" href={REGISTER_URL}>Crear mi cuenta <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={WA_URL} target="_blank" rel="noreferrer">Quiero saber más <span aria-hidden="true">→</span></a>
          </div>
          <p class="trial-note">15 días con todo incluido · Sin tarjeta · Gs. 150.000 / mes</p>
        </div>

        <div class="shell product-stage" id="producto" data-reveal>
          <div class="browser-frame">
            <div class="browser-bar">
              <div class="browser-dots"><i></i><i></i><i></i></div>
              <span>app.kioskit.space</span>
              <b>Seguro</b>
            </div>
            <div class="dashboard-mock" role="img" aria-label="Nuevo panel de KiosKit con copiloto, métricas y movimientos recientes">
              <aside class="mock-sidebar">
                <div class="mock-logo"><span>◆</span> KiosKit</div>
                <div class="mock-business"><i>AF</i><p><b>Almacén Ferreira</b><small>Negocio principal</small></p><span>⌄</span></div>
                <nav>
                  <b><span>⌂</span> Inicio</b>
                  <span><i>▣</i> POS</span>
                  <span><i>▤</i> Ventas</span>
                  <span><i>◇</i> Productos</span>
                  <span><i>⇄</i> Inventario</span>
                  <span><i>◎</i> Clientes</span>
                </nav>
                <div class="mock-help"><b>✦ ¿Necesitás una mano?</b><span>Preguntale a tu copiloto.</span></div>
              </aside>
              <div class="mock-workspace">
                <div class="mock-topbar"><b>Inicio</b><div><span>Buscar en KiosKit</span><i>◐</i><i>●</i></div></div>
                <div class="mock-dashboard-content">
                  <div class="mock-welcome"><div><h3>Buen día, Ana 👋</h3><p>Esto es lo importante de tu negocio ahora.</p></div><button>Nueva venta</button></div>
                  <div class="mock-ai-summary">
                    <span>✦</span><div><small>TU COPILOTO</small><b>Todo marcha bien. Hay 2 cosas que podés resolver rápido.</b><p>Quedan pocas unidades de agua mineral y tenés un cobro pendiente.</p></div><em>Revisar →</em>
                  </div>
                  <div class="mock-metrics">
                    <article><span>Ventas de hoy</span><b>Gs. 1.240.000</b><i>↗</i></article>
                    <article><span>Por cobrar</span><b>Gs. 185.000</b><i>◷</i></article>
                    <article><span>Stock bajo</span><b>3 productos</b><i>↓</i></article>
                  </div>
                  <div class="mock-lower">
                    <article><header><b>Últimos movimientos</b><span>Ver todos</span></header><p><i>↗</i><b>Venta #1042<small>Hace 8 min</small></b><strong>Gs. 84.000</strong></p><p><i>↗</i><b>Venta #1041<small>Hace 2 h</small></b><strong>Gs. 156.500</strong></p></article>
                    <article class="mock-shortcuts"><b>Atajos</b><span>＋ Agregar producto　→</span><span>◎ Anotar cobro　→</span></article>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="manifesto">
        <div class="shell manifesto-grid">
          <div class="manifesto-copy" data-reveal>
            <p class="kicker">Para el que vende, compra, cobra, repone y todavía contesta WhatsApp.</p>
            <h2>Tu negocio no debería sentirse como otra tarea administrativa.</h2>
            <p>
              Los equipos chicos necesitan moverse rápido. Pero entre cuadernos, memoria,
              planillas y sistemas pensados para empresas enormes, mantener el control se
              vuelve un trabajo aparte.
            </p>
          </div>
          <blockquote data-reveal>
            “KiosKit no te pide trabajar como una gran empresa. Te da las capacidades de una.”
          </blockquote>
        </div>
      </section>

      <section class="intelligence section" id="inteligencia">
        <div class="shell">
          <div class="intelligence-heading" data-reveal>
            <h2>Hablale a tu negocio.<br />KiosKit entiende qué hacer.</h2>
            <p>Escribí como hablás, en el copiloto de KiosKit o desde ChatGPT, Claude o Gemini. KiosKit cruza ventas, stock, clientes y caja, prepara la acción y vos la confirmás.</p>
          </div>

          <div class="ai-story" data-reveal>
            <div class="ai-story-source">
              <div class="story-label"><span>Hablá</span><small>Desde la app o desde tu IA</small></div>
              <div class="source-list">
                <div class="source source-kioskit"><i>✦</i><span><small>Dentro de la app</small><b>Copiloto KiosKit</b></span></div>
                <div class="source"><i>◎</i><span><small>Desde tu IA</small><b>ChatGPT</b></span></div>
                <div class="source"><i>C</i><span><small>Desde tu IA</small><b>Claude</b></span></div>
                <div class="source"><i>G</i><span><small>Desde tu IA</small><b>Gemini</b></span></div>
              </div>
            </div>

            <div class="story-arrow" aria-hidden="true"><span>→</span></div>

            <div class="ai-story-core">
              <div class="story-label"><span>KiosKit entiende</span><small>Consulta los datos de tu negocio</small></div>
              <div class="business-core">
                <div class="core-head"><i>K</i><span><b>Almacén Ferreira</b><small>Información actualizada</small></span><em>● En línea</em></div>
                <div class="core-data"><span>Ventas</span><span>Inventario</span><span>Clientes</span><span>Caja</span></div>
                <div class="core-message"><small>Le dijiste a KiosKit</small><p>“Vendí dos cocas en efectivo.”</p></div>
                <div class="core-processing"><span></span><b>Revisando producto, stock y precio…</b></div>
              </div>
            </div>

            <div class="story-arrow" aria-hidden="true"><span>→</span></div>

            <div class="ai-story-result">
              <div class="story-label"><span>Vos confirmás</span><small>Revisás la acción antes de hacerla</small></div>
              <div class="prepared-action">
                <header><span>Venta preparada</span><b>Lista para revisar</b></header>
                <div class="prepared-product"><i>2×</i><span><b>Coca-Cola 500 ml</b><small>Stock después de la venta: 18</small></span><strong>Gs. 20.000</strong></div>
                <p><span>Total</span><b>Gs. 20.000</b></p>
                <div class="prepared-cta">Confirmar venta</div>
              </div>
            </div>
          </div>

          <div class="ai-more-examples" data-reveal>
            <span>También podés pedir:</span>
            <p>“¿Qué tengo que reponer?” <b>→ Lista de stock bajo</b></p>
            <p>“¿Cómo cerró el día?” <b>→ Resumen de ventas y caja</b></p>
            <p>“Mostrame lo que me deben.” <b>→ Cobros pendientes</b></p>
          </div>
        </div>
      </section>

      <section class="storefront section" id="catalogo">
        <div class="shell storefront-grid">
          <div class="storefront-copy" data-reveal>
            <p class="storefront-kicker">Tu negocio también puede estar online.</p>
            <h2>¿Querés mostrar lo que tenés para vender? Publicalo.</h2>
            <p>
              Elegís los productos, activás tu catálogo y compartís el enlace. Sin montar otra
              tienda, duplicar precios ni cargar el stock de nuevo.
            </p>
            <ul>
              <li><span>✓</span> Tu propio enlace para compartir</li>
              <li><span>✓</span> Catálogo siempre conectado al stock</li>
              <li><span>✓</span> Listo para recibir pedidos</li>
            </ul>
          </div>
          <div class="storefront-preview" data-reveal role="img" aria-label="Ejemplo del catálogo online de un negocio en KiosKit">
            <div class="storefront-browser"><i></i><i></i><i></i><span>almacenferreira.kioskit.space</span></div>
            <header><div><b>Almacén Ferreira</b><small>Todo para tu día, cerca de vos.</small></div><span>Mi pedido　0</span></header>
            <div class="storefront-search">⌕　¿Qué estás buscando?</div>
            <nav><b>Todo</b><span>Almacén</span><span>Bebidas</span><span>Limpieza</span></nav>
            <div class="storefront-products">
              <article><img class="store-product" src="/storefront/yerba.png" alt="Paquete de yerba mate" loading="lazy" /><small>Almacén</small><b>Yerba mate 500 g</b><span>Gs. 18.500 <em>＋</em></span></article>
              <article><img class="store-product" src="/storefront/cafe.png" alt="Paquete de café molido" loading="lazy" /><small>Despensa</small><b>Café molido 250 g</b><span>Gs. 24.000 <em>＋</em></span></article>
              <article><img class="store-product" src="/storefront/agua.png" alt="Botella de agua mineral" loading="lazy" /><small>Bebidas</small><b>Agua mineral 500 ml</b><span>Gs. 5.000 <em>＋</em></span></article>
            </div>
          </div>
        </div>
      </section>

      <section class="thesis section" id="vision">
        <div class="shell thesis-grid">
          <div data-reveal>
            <h2>Los negocios chicos necesitan capacidades grandes, pero no la complejidad de una empresa grande.</h2>
            <p>
              KiosKit existe para darles una forma más natural de operar: entiende lo que
              necesitan hacer, reúne su trabajo y elimina burocracia, para que puedan mantener
              el control sin perder velocidad.
            </p>
          </div>
        </div>
      </section>

      <section class="closing section" id="precio">
        <div class="shell closing-panel" data-reveal>
          <div class="closing-copy">
            <h2>Que ordenar tu negocio<br />no te frene el negocio.</h2>
            <p>Todo KiosKit, en un único plan. Sin módulos escondidos ni configuraciones difíciles.</p>
          </div>
          <div class="closing-offer">
            <div class="price-block">
              <span>Un único plan</span>
              <strong><small>Gs.</small><span>150.000</span></strong>
              <p>al mes por negocio</p>
            </div>
            <div class="closing-actions">
              <a class="button button-amber" href={REGISTER_URL}>Probar KiosKit <span>↗</span></a>
              <small>15 días con todo incluido · Sin tarjeta</small>
              <a href={WA_URL} target="_blank" rel="noreferrer">¿Preferís hablar primero? Escribinos →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="faq section" id="preguntas">
        <div class="shell faq-grid">
          <div data-reveal>
            <h2>Lo esencial,<br />sin letra chica.</h2>
          </div>
          <div class="faq-list" data-reveal>
            {faqs.map((faq) => (
              <details>
                <summary>{faq.q}<span aria-hidden="true">+</span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <a href="#inicio" class="brand brand-footer"><span class="brand-mark">K</span><span>KiosKit</span></a>
        <p>Una forma más natural de operar tu negocio.</p>
        <div><a href={LOGIN_URL}>Ingresar</a><a href={WA_URL} target="_blank" rel="noreferrer">Contacto</a></div>
        <small>© {new Date().getFullYear()} KiosKit · Hecho en Paraguay</small>
      </div>
    </footer>

    <script>
      const header = document.querySelector("[data-header]");
      const menuButton = document.querySelector("[data-menu-button]");
      const mobileMenu = document.querySelector("[data-mobile-menu]");

      const syncHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      menuButton?.addEventListener("click", () => {
        const open = mobileMenu?.classList.toggle("is-open") ?? false;
        menuButton.setAttribute("aria-expanded", String(open));
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        mobileMenu.classList.remove("is-open");
        menuButton?.setAttribute("aria-expanded", "false");
      }));

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = document.querySelectorAll("[data-reveal]");
      if (reducedMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
